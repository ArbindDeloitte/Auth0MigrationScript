# Dashboard HTTP port
DASHBOARD_PORT=3001

# Redis connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Source users list key in Redis (must match migration-script configuration)
REDIS_SOURCE_KEY=migration:source:users

# Path to manual-review.xlsx (relative to this directory)
MANUAL_REVIEW_FILE=../migration-script/output/manual-review.xlsx
