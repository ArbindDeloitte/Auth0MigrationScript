# ─────────────────────────────────────────────
# Auth0 Management API (M2M Application)
# ─────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_MGMT_CLIENT_ID=your_m2m_client_id
AUTH0_MGMT_API_KEY=your_m2m_api_key

# The database connection to import users into
# Auth0 Dashboard → Authentication → Database → Settings → Connection ID
AUTH0_CONNECTION_ID=con_xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# Concurrency — Auth0 default tenant limit is 2 concurrent import jobs
# Raise only after Auth0 support increases your tenant limit
# ─────────────────────────────────────────────
MAX_CONCURRENT_AUTH0_JOBS=2

# ─────────────────────────────────────────────
# Redis — required by BullMQ and checkpoint store
# Production: enable AOF persistence (appendonly yes in redis.conf)
# ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# Input / Output paths
# ─────────────────────────────────────────────

# Redis key (List) where users are stored as JSON strings for migration
# Populated by the ETL (Script 1) — e.g. RPUSH migration:source:users '{"email":...}'
REDIS_SOURCE_KEY=migration:source:users

OUTPUT_DIR=./output
CHUNKS_DIR=./output/chunks

# Manual review output — Excel so the team can open and act on it directly
MANUAL_REVIEW_FILE=./output/manual-review.xlsx

# ─────────────────────────────────────────────
# Retry and polling
# ─────────────────────────────────────────────
MAX_USER_RETRIES=3
STATUS_POLL_INTERVAL_MS=30000
# 240 attempts x 30s = 2 hours (matches Auth0 job timeout)
STATUS_POLL_MAX_ATTEMPTS=240

# ─────────────────────────────────────────────
# Logging: debug | info | warn | error
# ─────────────────────────────────────────────
LOG_LEVEL=info
