# ─────────────────────────────────────────────
# Auth0 Management API (M2M Application)
# ─────────────────────────────────────────────
AUTH0_DOMAIN=brown-tuna-12264.cic-demo-platform.auth0app.com
AUTH0_MGMT_CLIENT_ID=pWl4DkuMQBoO7tG4h2JBz3jhojmVWitQ
AUTH0_MGMT_API_KEY=Zffxp-MjGaqUxhaQ4IA5lW_g1vi_FB2xOpvM6knjRnmISNR9V9Z2JFwBWD9iL47Y

# The database connection to import users into
# Auth0 Dashboard → Authentication → Database → Settings → Connection ID
AUTH0_CONNECTION_ID=con_S3XK8drzlEaJY2L4

# ─────────────────────────────────────────────
# Concurrency — Auth0 default tenant limit is 2 concurrent import jobs
# Raise only after Auth0 support increases your tenant limit
# ─────────────────────────────────────────────
MAX_CONCURRENT_AUTH0_JOBS=2

# ─────────────────────────────────────────────
# Import upsert mode
#   false (default) — existing users return per-user ALREADY_EXISTS errors,
#                     which are classified as confirmed and NOT retried.
#                     Keeps Redis success SET accurate.
#   true            — existing users are silently updated. Use only if you
#                     intentionally want to overwrite user attributes.
#                     WARNING: overwrites user_metadata and app_metadata entirely.
# ─────────────────────────────────────────────
AUTH0_IMPORT_UPSERT=false

# ─────────────────────────────────────────────
# Redis — required by BullMQ and checkpoint store
# Production: enable AOF persistence (appendonly yes in redis.conf)
# ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# Input / Output paths
# ─────────────────────────────────────────────

# Redis key (List) where users are stored as JSON strings for migration.
# Populated by the ETL (Script 1).
# Required source record fields:
#   email             — user's email address (required)
#   uid               — unique user ID used as Auth0 username (required)
#   first_name        — given name
#   last_name         — family name
#   password_hash     — base64-encoded SHA-512 hash (or ETL-structured object)
#   language_preference — e.g. "en", "es" → stored in user_metadata.language
#
# Example RPUSH:
#   redis-cli RPUSH migration:source:users \
#     '{"email":"j.doe@ladwp.com","uid":"jdoe01","first_name":"Jane","last_name":"Doe","password_hash":"<base64>","language_preference":"en"}'
REDIS_SOURCE_KEY=migration:source:users

OUTPUT_DIR=./output
CHUNKS_DIR=./output/chunks

# Manual review output — Excel so the team can open and act on it directly
MANUAL_REVIEW_FILE=./output/manual-review.xlsx

# ─────────────────────────────────────────────
# Username validation
# Auth0 default limit is 15 characters. Users with longer usernames are skipped
# from the import and written to manual-review.xlsx for source-data correction.
# ─────────────────────────────────────────────
AUTH0_USERNAME_MAX_LENGTH=15

# ─────────────────────────────────────────────
# Retry and polling
# ─────────────────────────────────────────────
MAX_USER_RETRIES=2
STATUS_POLL_INTERVAL_MS=30000
# 240 attempts x 30s = 2 hours (matches Auth0 job timeout)
STATUS_POLL_MAX_ATTEMPTS=240

# ─────────────────────────────────────────────
# Logging: debug | info | warn | error
# ─────────────────────────────────────────────
LOG_LEVEL=debug
